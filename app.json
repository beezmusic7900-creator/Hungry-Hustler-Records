{
  "expo": {
    "name": "Hungry Hustler",
    "slug": "hungry-hustler",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/cc665abf-a02b-4ce3-85e6-492dfdf3ec20.jpeg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/cc665abf-a02b-4ce3-85e6-492dfdf3ec20.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hungryhustler.app",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cc665abf-a02b-4ce3-85e6-492dfdf3ec20.jpeg",
        "backgroundColor": "#000000"
      },
      "package": "com.hungryhustler.app",
      "versionCode": 2,
      "permissions": [
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "hungryhustler",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://zh8kuu2uzjgumzgbwmaa3fb5a3dwbes5.app.specular.dev"
    }
  }
}